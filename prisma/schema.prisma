// Prisma schema for the multi-tenant sales dashboard.
// Each User owns their own Products and Orders — all queries are scoped by userId.
//
// The whole app runs on a single self-contained SQLite file — no external
// database, locally or on Vercel. A fresh `git clone` + `npm run dev` creates
// prisma/dev.db automatically; on Vercel the app runs against a copy in /tmp
// (see src/lib/prisma.ts).

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; "rhel-openssl-3.0.x" is the Vercel/AWS Lambda
  // runtime, so the deployed function ships with a query engine that loads there.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())

  products Product[]
  orders   Order[]
}

model Product {
  id        String   @id @default(cuid())
  userId    String
  name      String
  category  String
  price     Float
  stock     Int      @default(0)
  imageUrl  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

model Order {
  id           String   @id @default(cuid())
  userId       String
  productId    String?
  // Snapshots so an order's history survives even if the product is later deleted.
  productName  String
  category     String
  customerName String
  quantity     Int
  unitPrice    Float
  amount       Float
  status       String   @default("Unshipped") // "Unshipped" | "Shipped" | "Delivered" | "Canceled"
  createdAt    DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
}
